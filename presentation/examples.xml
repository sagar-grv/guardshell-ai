    <tr color="text-muted"><td>COMMAND</td><td>DECISION</td><td>GUARDSHELL RESPONSE</td></tr>
    <tr><td color="mint-safe">$ du -sh *</td><td color="mint-safe">SAFE</td><td color="text-muted">Allow controlled execution and review output.</td></tr>
    <tr><td color="amber-warn">$ sudo systemctl restart nginx</td><td color="amber-warn">CAUTION</td><td color="text-muted">Explain service impact and request confirmation.</td></tr>
    <tr><td color="#F28B63">$ rm -rf project/*</td><td color="#F28B63">HIGH RISK</td><td color="text-muted">Recommend preview-first or backup-first workflow.</td></tr>
    <tr><td color="red-risk">$ sudo rm -rf /</td><td color="red-risk">CRITICAL</td><td color="text-muted">Block deterministically; do not permit execution.</td></tr>
