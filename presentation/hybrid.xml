  <text id="section-label" x="60" y="58" width="410" height="22" font="caption" color="mint-safe" wrap="false">05 — HYBRID SAFETY MODEL</text>
  <text id="title" x="60" y="105" width="1020" height="52" font="heading" size="40" color="text-main" wrap="false">AI makes decisions understandable. Deterministic policy makes them safe.</text>
  <shape id="guarantee" type="rect" x="60" y="210" width="1160" height="50" fill="#72F2B212" stroke="#72F2B244" stroke-width="1"/>
  <text id="guarantee-copy" x="84" y="225" width="1110" height="22" font="body" size="17" color="mint-safe" align="center" wrap="false">The model never has final authority over a critical operation.</text>
  <shape id="ai-panel" type="rect" x="60" y="300" width="545" height="250" fill="bg-panel" stroke="#72F2B255" stroke-width="1"/>
  <text id="ai-kicker" x="90" y="330" width="230" height="22" font="caption" color="mint-safe">AI INTENT LAYER</text>
  <text id="ai-title" x="90" y="371" width="400" height="36" font="heading" size="30" color="text-main">Clarifies the command</text>
  <text id="ai-item1" x="90" y="437" width="440" height="24" font="body" size="16" color="text-muted">• Interprets likely user intent in plain language</text>
  <text id="ai-item2" x="90" y="473" width="440" height="24" font="body" size="16" color="text-muted">• Explains technical impact without jargon</text>
  <text id="ai-item3" x="90" y="509" width="440" height="24" font="body" size="16" color="text-muted">• Proposes safer alternatives and preview steps</text>
  <shape id="policy-panel" type="rect" x="675" y="300" width="545" height="250" fill="bg-panel" stroke="#FF4C4C55" stroke-width="1"/>
  <text id="policy-kicker" x="705" y="330" width="300" height="22" font="caption" color="red-risk">DETERMINISTIC POLICY</text>
  <text id="policy-title" x="705" y="371" width="420" height="36" font="heading" size="30" color="text-main">Controls the outcome</text>
  <text id="policy-item1" x="705" y="437" width="440" height="24" font="body" size="16" color="text-muted">• Detects protected paths and dangerous patterns</text>
  <text id="policy-item2" x="705" y="473" width="440" height="24" font="body" size="16" color="text-muted">• Enforces privilege and execution restrictions</text>
  <text id="policy-item3" x="705" y="509" width="440" height="24" font="body" size="16" color="text-muted">• Blocks critical actions regardless of AI output</text>
  <shape id="split-line" type="line" x="640" y="300" width="0" height="250" stroke="hairline" stroke-width="1"/>
  <text id="authority" x="60" y="594" width="1160" height="26" font="body" size="18" color="ice-blue" align="center" wrap="false">AI can clarify an action. It cannot overrule a critical policy.</text>
  <text id="footer-page" x="60" y="676" width="80" height="20" font="caption" color="text-muted" wrap="false">06 / 10</text>
