  <text id="section-label" x="60" y="58" width="250" height="22" font="caption" color="mint-safe" wrap="false">02 — OUR OBJECTIVE</text>
  <text id="title" x="60" y="105" width="950" height="52" font="heading" size="40" color="text-main" wrap="false">Place an explainable decision between the user and the shell.</text>
  <text id="objective-copy" x="60" y="184" width="950" height="60" font="body" size="19" color="text-muted" line-height="1.35">GuardShell AI identifies intent, interprets risk signals, explains impact, and selects the safest viable next action before a Linux command reaches execution.</text>
  <shape id="safe-card" type="rect" x="60" y="300" width="275" height="252" fill="bg-panel" stroke="#72F2B255" stroke-width="1"/>
  <text id="safe-number" x="84" y="327" width="60" height="24" font="caption" color="mint-safe">01</text>
  <text id="safe-title" x="84" y="373" width="200" height="34" font="heading" size="27" color="mint-safe">ALLOW</text>
  <text id="safe-copy" x="84" y="430" width="210" height="74" font="body" size="16" color="text-muted" line-height="1.35">Safe inspection commands may proceed through a controlled path.</text>
  <shape id="caution-card" type="rect" x="355" y="300" width="275" height="252" fill="bg-panel" stroke="#F5A62355" stroke-width="1"/>
  <text id="caution-number" x="379" y="327" width="60" height="24" font="caption" color="amber-warn">02</text>
  <text id="caution-title" x="379" y="373" width="220" height="34" font="heading" size="27" color="amber-warn">CONFIRM</text>
  <text id="caution-copy" x="379" y="430" width="210" height="74" font="body" size="16" color="text-muted" line-height="1.35">Cautionary changes receive an impact explanation and an explicit consent step.</text>
  <shape id="guide-card" type="rect" x="650" y="300" width="275" height="252" fill="bg-panel" stroke="#F28B6355" stroke-width="1"/>
  <text id="guide-number" x="674" y="327" width="60" height="24" font="caption" color="#F28B63">03</text>
  <text id="guide-title" x="674" y="373" width="200" height="34" font="heading" size="27" color="#F28B63">GUIDE</text>
  <text id="guide-copy" x="674" y="430" width="210" height="74" font="body" size="16" color="text-muted" line-height="1.35">High-risk commands are paired with a preview-first or backup-first alternative.</text>
  <shape id="block-card" type="rect" x="945" y="300" width="275" height="252" fill="bg-panel" stroke="#FF4C4C66" stroke-width="1"/>
  <text id="block-number" x="969" y="327" width="60" height="24" font="caption" color="red-risk">04</text>
  <text id="block-title" x="969" y="373" width="200" height="34" font="heading" size="27" color="red-risk">BLOCK</text>
  <text id="block-copy" x="969" y="430" width="210" height="74" font="body" size="16" color="text-muted" line-height="1.35">Critical actions are denied by deterministic policy and cannot be overridden by the model.</text>
